    <string name="about_summary">Version v%1$s · %2$s</string>
    <string name="about_project_intro">LiquidVivo is a blur-tuning tool for the OriginOS system interface. Built on libxposed API 102, it lets you shape the feel of the notification shade, control center, lock screen, volume panel and Dynamic Island. Check the framework connection, manage LSPosed scope, then tune each surface until it feels right.</string>
    <string name="about_section_project">Project</string>
    <string name="about_section_features">Highlights</string>
