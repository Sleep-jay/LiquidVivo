    <string name="about_feature_hooks">Graceful under change</string>
    <string name="about_feature_hooks_summary">Each hook fails on its own terms. When a version changes an obfuscated name, LiquidVivo records and skips that one path without bringing down the rest.</string>
    <string name="about_feature_interface">A clear place to tune</string>
    <string name="about_feature_interface_summary">Built with Jetpack Compose and Miuix, with Monet colors and light or dark themes. It stays out of the way and keeps the controls close at hand.</string>
    <string name="about_feature_scope">Scope, kept simple</string>
    <string name="about_feature_scope_summary">Read, grant or revoke LSPosed scope here without bouncing between two apps.</string>
