    <string name="settings_app_name">Settings</string>
    <string name="settings_app_feature">Customizes the About Phone page (background image and editable device info). Game frame interpolation / Monster+ are written to system keys through this process: open Settings once and leave it in the background before using them.</string>
    <string name="systemui_app_name">System UI</string>
    <string name="systemui_app_feature">Customizes blur effects of SystemUI and its plugin (one scope request covers both processes).\n· Blur radius / translucency are tuned independently per scene: volume panel, system popups (translucency only), the atomic island and other surfaces (incl. lock screen notification cards); the notification shade &amp; control center (shared panel background) and the lock screen support radius only because their intensity is ROM-baked / animation driven.\n· Atomic island: the collapsed capsule uses the same dark blur material as the expanded state, following the island sub-items.\n· Heads-up notification cards follow the notification shade blur radius.</string>
    <string name="blur_radius_title">Blur radius</string>
    <string name="blur_radius_summary">Currently %1$d%%</string>
    <string name="blur_alpha_title">Translucency</string>
    <string name="blur_alpha_summary">Currently %1$d%%</string>
    <string name="blur_liquid_glass_title">Liquid glass</string>
    <string name="blur_liquid_glass_caption">A light, translucent glass treatment for System UI: notification shade, control center cards and buttons, volume panel and Dynamic Island keep live blur with a softer mask. Turn it off to restore the stock overlay. Opacity 0 is fully clear.</string>
    <string name="blur_glass_opacity_title">Glass opacity</string>
    <string name="blur_glass_opacity_summary">Currently %1$d%%</string>
    <string name="blur_glass_radius_title">Liquid glass blur radius</string>
    <string name="blur_sidebar_radius_title">Sidebar / expanded card glass radius</string>
    <string name="blur_glass_radius_summary">Currently %1$d px</string>
    <string name="blur_reset">Restore defaults</string>
    <string name="blur_hint">Each scene is tuned independently and applies live; surfaces already on screen refresh after they redraw (re-expand the shade or reopen the panel). 0%% disables the mask, above 100%% strengthens it. A legacy global value is used as fallback for scenes not tuned individually.</string>
    <string name="blur_scene_shade">Notification shade / Control center</string>
    <string name="blur_scene_shade_caption">Shade panel background and other blurred surfaces; the control center shares the same panel background. The panel mask strength is baked by the ROM and cannot be tuned live, so only blur radius is offered here. Heads-up notification cards also follow this scene\'s blur radius</string>
    <string name="blur_scene_volume">Volume panel</string>
    <string name="blur_scene_volume_caption">Volume slider background blur</string>
    <string name="blur_scene_keyguard">Lock screen</string>
    <string name="blur_scene_keyguard_caption">Lock screen, unlock panel and other blurred surfaces. The lock screen intensity is ROM-animation driven and cannot be tuned live, so only blur radius is offered here. Lock screen notification cards are tuned under \"Other surfaces\"</string>
    <string name="blur_scene_popup">System popups</string>
    <string name="blur_scene_popup_caption">Translucent backgrounds of popups such as low battery (translucency only)</string>
    <string name="blur_scene_island">Atomic island</string>
    <string name="blur_scene_island_caption">The unified dark blur material of the collapsed/expanded capsule</string>
    <string name="blur_scene_other">Other surfaces</string>
    <string name="blur_scene_other_caption">Blur surfaces and material tokens not covered by the scenes above; lock screen notification cards also follow both controls of this scene</string>
