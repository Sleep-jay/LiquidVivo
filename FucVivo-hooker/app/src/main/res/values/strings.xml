    <string name="about_feature_hooks">Runtime hooks</string>
    <string name="about_feature_hooks_summary">Every hook is guarded on its own, so an obfuscated name that drifts between app versions is logged and skipped instead of taking the whole module down.</string>
    <string name="about_feature_interface">Miuix interface</string>
    <string name="about_feature_interface_summary">Written in Jetpack Compose using the Miuix design language, with Monet colors and light/dark themes.</string>
    <string name="about_feature_scope">Scope management</string>
    <string name="about_feature_scope_summary">Reads the LSPosed scope through the framework service, so it can be granted or revoked here without switching to LSPosed.</string>
