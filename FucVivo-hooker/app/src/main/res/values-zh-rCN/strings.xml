    <string name="settings_app_name">设置</string>
    <string name="settings_app_feature">关于手机页支持自定义背景图与点击修改设备信息。游戏插帧/Monster+ 经设置进程写入系统键：使用前请先打开一次系统设置并置于后台。</string>
    <string name="systemui_app_name">系统界面</string>
    <string name="systemui_app_feature">给 OriginOS 的系统界面做一点随手可调的模糊：一次加入作用域，同时覆盖 SystemUI、插件、侧边栏窗口和侧边栏内容卡片。\n· 通知中心、控制中心、侧边栏展开卡片、音量面板、系统弹窗、原子岛和锁屏等场景各自保存参数。\n· 侧边栏 / 展开卡片使用单独的液态玻璃半径控制。\n· 原子岛收起与展开共用同一套深色玻璃材质。</string>
    <string name="blur_radius_title">模糊半径</string>
    <string name="blur_radius_summary">当前 %1$d%%</string>
    <string name="blur_alpha_title">不透明度</string>
    <string name="blur_alpha_summary">当前 %1$d%%</string>
    <string name="blur_liquid_glass_title">液态玻璃</string>
    <string name="blur_liquid_glass_caption">让系统界面呈现轻透的液态玻璃：通知中心、控制中心（含卡片和按钮）、音量面板、原子岛都保留实时模糊、压低遮罩、略提饱和度。关闭「液态玻璃」即可回到原生遮罩。不透明度 0 为全透明。</string>
    <string name="blur_glass_opacity_title">玻璃不透明度</string>
    <string name="blur_glass_opacity_summary">当前 %1$d%%</string>
    <string name="blur_glass_radius_title">液态玻璃模糊半径</string>
    <string name="blur_sidebar_radius_title">侧边栏 / 展开卡片液态玻璃半径</string>
    <string name="blur_glass_radius_summary">当前 %1$d px</string>
    <string name="blur_reset">恢复默认</string>
    <string name="blur_hint">每个场景各走各的路，调整后会实时写入；已经打开的界面重绘一次就会刷新。0%% 为完全透明，超过 100%% 会更浓；未单独设置的场景仍会沿用旧版全局数值。</string>
    <string name="blur_scene_shade">通知中心 / 控制中心</string>
    <string name="blur_scene_shade_caption">下拉面板背景等模糊表面；与控制中心共用同一面板背景。面板遮罩浓度由 ROM 烘焙、不支持实时调节，故此场景仅提供模糊半径。悬浮通知卡片也跟随本场景的模糊半径</string>
    <string name="blur_scene_volume">音量面板</string>
    <string name="blur_scene_volume_caption">音量条背景模糊</string>
    <string name="blur_scene_keyguard">锁屏</string>
    <string name="blur_scene_keyguard_caption">锁屏与解锁面板等模糊表面。锁屏浓度由 ROM 动画驱动、不支持实时调节，故此场景仅提供模糊半径。锁屏通知卡片由「其他表面」调节</string>
    <string name="blur_scene_popup">系统弹窗</string>
    <string name="blur_scene_popup_caption">电量不足等弹窗的半透明背景（仅不透明度）</string>
    <string name="blur_scene_island">原子岛</string>
    <string name="blur_scene_island_caption">胶囊收起与展开态统一的深色模糊材质</string>
    <string name="blur_scene_other">其他表面</string>
    <string name="blur_scene_other_caption">未归入以上场景的模糊表面与材质 token；锁屏通知卡片也跟随本场景的两项调节</string>
